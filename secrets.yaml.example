# TFI Display — API key (secrets)
# Copy to /etc/tfi-display/secrets.yaml and fill in your key.
# Get a free API key: https://developer.nationaltransport.ie/
#
# Set restrictive permissions so only root can read it:
#   sudo chown root:root /etc/tfi-display/secrets.yaml
#   sudo chmod 600 /etc/tfi-display/secrets.yaml
#
# This file is never WRITTEN by tfi-agent. The agent reads only device_token
# from it (to fetch config and report failures); api_key is for tfi-display.
# Alternatively, set the TFI_API_KEY environment variable.

api_key: "your-api-key-here"

# tfi-agent device key: the per-config-file access token from the dandev
# settings page ("device key" field). Authorises this device to fetch its
# config and report failed releases. Leave blank to disable config sync
# (binary updates still work — /latest is public).
device_token: "your-device-token-here"
