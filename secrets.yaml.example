# TFI Display — API key (secrets)
# Copy to /etc/tfi-display/secrets.yaml and fill in your key.
# Get a free API key: https://developer.nationaltransport.ie/
#
# Set restrictive permissions so only root can read it:
#   sudo chown root:root /etc/tfi-display/secrets.yaml
#   sudo chmod 600 /etc/tfi-display/secrets.yaml
#
# This file is never WRITTEN by tfi-agent. The agent reads only device_token
# from it (to fetch config and report failures); api_key is for tfi-display.
# Alternatively, set the TFI_API_KEY environment variable.

api_key: "your-api-key-here"

# tfi-agent: the origin of the update server this device syncs from (tfi-agent
# is optional — see README.md). Lives here, not in config.yaml, because the
# agent overwrites config.yaml on each sync but never touches secrets.yaml — so
# the base URL survives. Required for the agent to do anything.
base_url: "https://your-instance.example.com"

# tfi-agent device key: the per-device access token issued by your update
# server. Authorises this device to fetch its config and report failed
# releases. Leave blank to disable config sync (binary updates still work —
# /latest is public).
device_token: "your-device-token-here"
